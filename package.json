{
  "name": "look-outside-timer",
  "productName": "Look Outside Timer",
  "version": "1.0.7",
  "description": "Eye-break reminder that respects your idle time and never interrupts a call.",
  "main": "src/main/main.js",
  "author": "Brendan Millar",
  "license": "MIT",
  "private": true,
  "scripts": {
    "icon": "node scripts/gen-icon.js",
    "store-logos": "node scripts/gen-store-logos.js",
    "start": "electron .",
    "dist": "npm run icon && electron-builder --win",
    "dist:store": "npm run icon && electron-builder --win appx",
    "pack": "npm run icon && electron-builder --win --dir",
    "test": "electron scripts/selftest.js",
    "autostart:on": "node scripts/autostart.js on",
    "autostart:off": "node scripts/autostart.js off",
    "autostart:status": "node scripts/autostart.js status",
    "preview": "electron . --preview"
  },
  "build": {
    "appId": "com.brendanmillar.lookoutsidetimer",
    "productName": "Look Outside Timer",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.ico"
    ],
    "asarUnpack": [
      "build/icon.ico"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "LookOutsideTimer-Setup-${version}.${ext}"
    },
    "appx": {
      "identityName": "Brendaniam.LookOutsideReminder",
      "publisher": "CN=E9DA397B-6A5C-4151-98C6-93DD15F901B8",
      "publisherDisplayName": "Brendaniam",
      "applicationId": "LookOutsideReminder",
      "displayName": "Look Outside Reminder",
      "backgroundColor": "transparent",
      "languages": [
        "en-US"
      ],
      "minVersion": "10.0.17763.0",
      "maxVersionTested": "10.0.26100.0",
      "customExtensionsPath": "build/appx-extensions.xml",
      "artifactName": "LookOutsideReminder-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  }
}
